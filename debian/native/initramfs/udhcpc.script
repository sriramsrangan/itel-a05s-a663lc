#!/bin/sh
# busybox udhcpc hook: Wi-Fi gets the preferred default route (metric 100); LTE keeps metric 1000.
case "$1" in
  deconfig) ip addr flush dev "$interface"; ip route del default dev "$interface" 2>/dev/null ;;
  bound|renew)
    ip addr flush dev "$interface"; ip addr add "$ip/${mask:-24}" dev "$interface"
    ip route del default dev "$interface" 2>/dev/null
    for r in $router; do ip route add default via "$r" dev "$interface" metric 100; break; done
    : > /etc/resolv.conf; for d in $dns 8.8.8.8; do echo "nameserver $d" >> /etc/resolv.conf; done ;;
esac
