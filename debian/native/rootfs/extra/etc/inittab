# Call box init (busybox init). This kernel has no devtmpfs and no CONFIG_FHANDLE, so systemd and udev
# cannot run; services are started and restarted from here instead. Each runs under callbox-svc,
# which logs to syslog and waits before a restart.
::sysinit:/opt/callbox/sbin/callbox-sysinit
::respawn:/opt/callbox/sbin/callbox-svc mdev /usr/bin/busybox mdev -df
::respawn:/opt/callbox/sbin/callbox-svc syslogd /usr/bin/busybox syslogd -n -O /var/log/messages -s 4000 -b 4
::respawn:/opt/callbox/sbin/callbox-svc klogd /usr/bin/busybox klogd -n
::respawn:/opt/callbox/sbin/callbox-svc modem-control /android/bin/modem_control
::respawn:/opt/callbox/sbin/callbox-svc cp-diskserver /opt/callbox/sbin/callbox-after-modem /android/bin/cp_diskserver
::respawn:/opt/callbox/sbin/callbox-svc refnotify /opt/callbox/sbin/callbox-after-modem /android/bin/refnotify
::respawn:/opt/callbox/sbin/callbox-svc vbc /usr/bin/python3 -m callbox.vbc
::respawn:/opt/callbox/sbin/callbox-svc agent /usr/bin/python3 -m callbox.agent
::respawn:/opt/callbox/sbin/callbox-svc wpa /opt/callbox/sbin/callbox-after-wlan /usr/sbin/wpa_supplicant -D nl80211 -i wlan0 -c /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
::respawn:/opt/callbox/sbin/callbox-svc dhcp-wlan0 /opt/callbox/sbin/callbox-after-wlan /usr/bin/busybox udhcpc -f -i wlan0 -s /opt/callbox/sbin/callbox-udhcpc -t 5 -T 3 -A 10
::respawn:/opt/callbox/sbin/callbox-svc wifi-route /opt/callbox/sbin/callbox-wifi-route
::respawn:/opt/callbox/sbin/callbox-svc sshd /usr/sbin/sshd -D -e
::respawn:/opt/callbox/sbin/callbox-svc chronyd /usr/sbin/chronyd -d -s
::respawn:/opt/callbox/sbin/callbox-svc screen-timeout /opt/callbox/sbin/callbox-screen-timeout
::once:/usr/local/sbin/callbox-boot-report
::shutdown:/opt/callbox/sbin/callbox-shutdown
::restart:/usr/bin/busybox init
