#!/usr/bin/python3
"""callbox-screen-timeout: turn the panel backlight off after a period with no button press,
and turn it back on when any hardware key is pressed.

The call box has no desktop and no DPMS, so nothing dims the screen on its own. This watches the
gpio-keys (volume, power) and the headset keyboard, and drives the Spreadtrun backlight directly
through sysfs. We open the input devices read-only and never grab them, so the keys keep doing
their normal jobs while we only observe them to wake the screen.

Settings live in /etc/callbox/screen.conf (shell-style KEY=value), all optional:
  TIMEOUT_SECONDS   idle seconds before the screen goes off (default 10)
  WAKE_ON_START     1 to start with the screen on (default 1)
"""
import glob
import os
import select
import struct
import time

BACKLIGHT = "/sys/class/backlight/sprd_backlight"
CONF = "/etc/callbox/screen.conf"
EV_KEY = 1
# struct input_event on 64-bit: struct timeval (2x long), __u16 type, __u16 code, __s32 value
FMT = "llHHi"
SZ = struct.calcsize(FMT)


def read_conf():
    timeout, wake_on_start = 10.0, True
    try:
        with open(CONF) as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, val = line.partition("=")
                key, val = key.strip(), val.strip().strip('"').strip("'")
                if key == "TIMEOUT_SECONDS":
                    try:
                        timeout = max(1.0, float(val))
                    except ValueError:
                        pass
                elif key == "WAKE_ON_START":
                    wake_on_start = val not in ("0", "false", "no", "")
    except OSError:
        pass
    return timeout, wake_on_start


def write_sysfs(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError:
        return False


def set_screen(on):
    # bl_power follows the FB_BLANK values: 0 = unblank (on), 4 = power down (off).
    write_sysfs(BACKLIGHT + "/bl_power", 0 if on else 4)


def key_devices():
    """Input event nodes that report EV_KEY, so we watch buttons and ignore the vibrator etc."""
    devs = []
    for cap in sorted(glob.glob("/sys/class/input/event*/device/capabilities/key")):
        try:
            with open(cap) as f:
                bits = f.read().strip()
        except OSError:
            continue
        if bits and set(bits.replace(" ", "")) != {"0"}:
            node = "/dev/input/" + cap.split("/")[4]
            if os.path.exists(node):
                devs.append(node)
    return devs or ["/dev/input/event0"]


def main():
    timeout, wake_on_start = read_conf()
    fds = []
    for node in key_devices():
        try:
            fds.append(os.open(node, os.O_RDONLY | os.O_NONBLOCK))
        except OSError:
            pass
    if not fds:
        return

    on = True
    set_screen(wake_on_start)
    on = bool(wake_on_start)
    last_activity = time.monotonic()

    while True:
        ready, _, _ = select.select(fds, [], [], 1.0)
        pressed = False
        for fd in ready:
            try:
                data = os.read(fd, SZ * 64)
            except OSError:
                continue
            for off in range(0, len(data) - SZ + 1, SZ):
                ev_type = struct.unpack_from(FMT, data, off)[2]
                if ev_type == EV_KEY:
                    pressed = True
        now = time.monotonic()
        if pressed:
            last_activity = now
            if not on:
                set_screen(True)
                on = True
        elif on and (now - last_activity) >= timeout:
            set_screen(False)
            on = False


if __name__ == "__main__":
    main()
