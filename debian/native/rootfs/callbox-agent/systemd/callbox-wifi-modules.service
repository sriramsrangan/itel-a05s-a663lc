[Unit]
Description=Call box: mount prodnv and load the WCN and Wi-Fi drivers (wlan0)
Requires=callbox-android-prep.service
After=callbox-android-prep.service
Before=wpa_supplicant@wlan0.service systemd-networkd.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/callbox/sbin/callbox-wifi-modules.sh

[Install]
WantedBy=multi-user.target
