[Unit]
Description=Call box agent (modem, SMS, data, jobs and heartbeats for hm-gateway)
Wants=callbox-modem-control.service callbox-cp-diskserver.service callbox-refnotify.service callbox-vbc.service network-online.target
After=callbox-modem-control.service callbox-cp-diskserver.service callbox-refnotify.service callbox-vbc.service systemd-resolved.service
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=PYTHONPATH=/opt/callbox
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m callbox.agent
Restart=always
RestartSec=10
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
