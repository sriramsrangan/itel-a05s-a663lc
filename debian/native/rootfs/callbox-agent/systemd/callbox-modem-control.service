[Unit]
Description=Call box: Android modem_control (loads and starts the modem, feeds the power-chip watchdog)
Requires=callbox-android-prep.service
After=callbox-android-prep.service

[Service]
Type=simple
Environment=LD_LIBRARY_PATH=/android/lib64
ExecStart=/android/bin/modem_control
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
